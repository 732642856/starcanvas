# ============================================================================
# StarCanvas — AI Provider 配置模板 (v2 — Multi-Provider)
# ============================================================================
# 复制此文件为 .env.local 并填写你的 Provider 配置。
#
# 支持三种模式:
#   server-env  — Key 存 .env.local（适合自部署/团队部署）
#   relay       — 自建中转站模式，Key 放在自己的 proxy 里
#   session-key — 临时会话 Key（仅内存，不持久化）
#
# 向后兼容：旧 AI_BASE_URL/AI_API_KEY 会自动创建 id="default" 的 Provider。
# ============================================================================

# ── 主 Provider（向后兼容，自动映射为 id="default"） ──────────────────────

# 中转站 Base URL（OpenAI 兼容协议）
AI_BASE_URL=https://your-proxy.example.com/v1

# 中转站 API Key
AI_API_KEY=sk-your-key-here

# 默认文本模型
AI_DEFAULT_MODEL=gpt-4o-mini

# 默认图片模型（不配则走 AI_DEFAULT_MODEL）
AI_DEFAULT_IMAGE_MODEL=gpt-image-2

# 视频分析专用模型（不配则走 AI_DEFAULT_MODEL）
AI_VIDEO_MODEL=

# 图片模型列表（逗号分隔，用于运行时判断模型类型）
AI_IMAGE_MODELS=gpt-image-2,dall-e-3

# 视频模型列表（逗号分隔）
AI_VIDEO_MODELS=

# 请求超时（毫秒）
AI_REQUEST_TIMEOUT_MS=120000

# 图片生成重试次数
AI_IMAGE_RETRY_ATTEMPTS=2

# ── 多 Provider 配置（新格式，推荐） ──────────────────────────────────────
#
# 命名规则: AI_PROVIDER_<ID>_<PROPERTY>
#   <ID> 使用大写 + 下划线，例如 OPENAI / IDEOGRAM / DASHSCOPE
#   支持的 PROPERTY:
#     NAME          — 显示名称
#     BASE_URL      — Base URL
#     API_KEY       — API Key
#     DEFAULT_MODEL — 默认文本模型
#     IMAGE_MODEL   — 默认图片模型
#     VIDEO_MODEL   — 默认视频模型
#     IMAGE_MODELS  — 图片模型列表（逗号分隔）
#     VIDEO_MODELS  — 视频模型列表（逗号分隔）
#     AUDIO_MODELS  — 音频模型列表（逗号分隔）
#     CAPABILITIES  — 能力列表: text,image,video,audio（逗号分隔）
#     TIMEOUT_MS    — 超时（毫秒）
#
# 示例:
#
# AI_PROVIDER_OPENAI_NAME=OpenAI (自建中转站)
# AI_PROVIDER_OPENAI_BASE_URL=https://my-openai-proxy.example.com/v1
# AI_PROVIDER_OPENAI_API_KEY=sk-my-key
# AI_PROVIDER_OPENAI_DEFAULT_MODEL=gpt-4o
# AI_PROVIDER_OPENAI_IMAGE_MODELS=gpt-image-2,dall-e-3
# AI_PROVIDER_OPENAI_CAPABILITIES=text,image
# AI_PROVIDER_OPENAI_TIMEOUT_MS=120000
#
# AI_PROVIDER_GEMINI_NAME=Gemini
# AI_PROVIDER_GEMINI_BASE_URL=https://my-gemini-proxy.example.com/v1
# AI_PROVIDER_GEMINI_API_KEY=sk-gemini-key
# AI_PROVIDER_GEMINI_DEFAULT_MODEL=gemini-2.0-flash
# AI_PROVIDER_GEMINI_CAPABILITIES=text,image

# ── 专用 Provider（旧格式兼容，自动扫描并注册） ──────────────────────────

# Ideogram 图片生成
IDEOGRAM_API_KEY=

# 阿里云百炼 DashScope（Vidu 视频生成）
DASHSCOPE_API_KEY=

# Kling AI 视频生成
KLING_API_KEY=

# Seedance 视频生成
SEEDANCE_API_KEY=

# ── 可选 AI 后端服务 ─────────────────────────────────────────────────────

# VoxCPM2 TTS 服务地址（如部署了本地 TTS 服务）
VOXCPM_BASE_URL=

# 数字人/照片说话服务地址（MuseTalk / LivePortrait Docker 容器）
TALKING_PHOTO_SERVICE_URL=

# ── 开发/调试 ────────────────────────────────────────────────────────────

# 启用 Mock 模式（不实际调用 AI API）
NEXT_PUBLIC_USE_MOCK=false

# ── 废弃变量（已不再使用） ────────────────────────────────────────────────

# NEXT_PUBLIC_API_BASE_URL — 改为 AI_BASE_URL
# OPENAI_API_KEY — 改为 AI_API_KEY
